<?xml version="1.0" encoding="UTF-8"?>
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" type="static" mediaPresentationDuration="PT6S"
     minBufferTime="PT2S" profiles="urn:mpeg:dash:profile:isoff-on-demand:2011">
  <Period duration="PT6S">
    <AdaptationSet mimeType="video/mp4">
      <Representation id="v1" bandwidth="500000" width="320" height="180" codecs="avc1.42c00d">
        <BaseURL>video/</BaseURL>
        <SegmentList duration="3" timescale="1">
          <Initialization sourceURL="init.mp4"/>
          <SegmentURL media="seg-1.m4s"/>
          <SegmentURL media="seg-2.m4s"/>
        </SegmentList>
      </Representation>
    </AdaptationSet>
    <AdaptationSet mimeType="audio/mp4">
      <!-- 6s / 2s per segment = segments 1, 2 and 3 -->
      <SegmentTemplate initialization="audio/init-$RepresentationID$.mp4"
                       media="audio/$RepresentationID$-$Number$.m4s"
                       startNumber="1" duration="2" timescale="1"/>
      <Representation id="a1" bandwidth="64000" codecs="mp4a.40.2"/>
    </AdaptationSet>
    <AdaptationSet mimeType="video/mp4">
      <Representation id="v2" bandwidth="1000000" codecs="avc1.42c00d">
        <BaseURL>single/whole.mp4</BaseURL>
        <SegmentBase indexRange="0-100"/>
      </Representation>
    </AdaptationSet>
  </Period>
</MPD>
